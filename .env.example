# Copy to .env.local for local dev. Do NOT commit real secrets.
# Runtime values for deployments are configured in Vercel:
#   Project → Settings → Environment Variables (Production / Preview / Development)

# Public vars — exposed to the browser. Use one of these prefixes based on framework:
#   Next.js:     NEXT_PUBLIC_*
#   Vite:        VITE_*
#   Astro/SK:    PUBLIC_*
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Server-only secrets (never commit real values)
# DATABASE_URL=
# SESSION_SECRET=
